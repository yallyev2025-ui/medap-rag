# Telegram
TELEGRAM_BOT_TOKEN=

# --- LLM-провайдеры (ТЗ §56/§60) ---------------------------------------------
# Модель под каждую атомарную задачу выбирает TaskModelMap (app/llm/task_map.py),
# а не эта переменная напрямую.

# DeepSeek — grounded-генерация, объяснения, решение задач по тексту.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI — восприятие (Vision) и оценка ответов студента.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Пусто = берём OPENAI_MODEL. Задайте явно при переходе на GPT-5.4 Mini
# и не забудьте обновить цены ниже вместе с PRICING_VERSION.
OPENAI_EVAL_MODEL=
# Базовый URL OpenAI-совместимого API. Пусто = облако OpenAI.
OPENAI_BASE_URL=

# Переопределение TaskModelMap без выката кода, JSON:
# {"GROUNDED_QA": "openai", "VISION_EXTRACT": "deepseek"}
TASK_MODEL_MAP_OVERRIDES=

# Speech-to-Text (§20, этап 4A.7) — только OpenAI Whisper.
WHISPER_MODEL=whisper-1
ORAL_MAX_AUDIO_MB=15

# Настоящий веб-поиск (§19 ТЗ) — Yandex Search API (Yandex Cloud), российский
# биллинг. Оба поля нужны вместе — folderId отдельная сущность от ключа.
# Пусто = функция вернёт честную "не настроено", без падения.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_SNIPPET_MAX_CHARS=2000

# PubMed (сверх исходного ТЗ) — NCBI E-utilities, бесплатный публичный API,
# ключ НЕ обязателен. PUBMED_CONTACT_EMAIL — необязательная рекомендация NCBI.
PUBMED_MAX_RESULTS=5
PUBMED_CONTACT_EMAIL=

# --- Цены провайдеров: доллары за 1M токенов (ТЗ §59, §64) --------------------
PRICING_VERSION=2026-09-19
DEEPSEEK_INPUT_PRICE_USD=0.30
DEEPSEEK_CACHED_INPUT_PRICE_USD=0.03
DEEPSEEK_OUTPUT_PRICE_USD=1.20
OPENAI_EVAL_INPUT_PRICE_USD=0.75
OPENAI_EVAL_CACHED_INPUT_PRICE_USD=0.075
OPENAI_EVAL_OUTPUT_PRICE_USD=4.50
# Whisper тарифицируется по минутам аудио, не по токенам.
OPENAI_WHISPER_PRICE_USD_PER_MINUTE=0.006
# Курс для перевода стоимости в рубли на дашборде.
USD_RUB_RATE=84.1975

# PostgreSQL с расширением pgvector (managed-БД Timeweb отдаёт postgres:// —
# схема приводится к asyncpg автоматически в config.py). Если панель хостинга
# добавила в строку "?sslmode=..." — можно не убирать вручную, code сам вырежет
# этот параметр (asyncpg его не понимает, в отличие от psycopg2/libpq).
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# SSL к БД: "require" (шифровать, не проверять сертификат — безопасный дефолт
# для managed-БД без своего CA-бандла в образе), "verify-full" (проверять по
# системным доверенным центрам — включайте, если у провайдера публично
# доверенный сертификат) или "disable".
DATABASE_SSL_MODE=require

# --- S3-хранилище оригиналов источников (ТЗ §8.2.4, §33) --------------------
# Пусто = оригиналы не сохраняются (мягкая деградация — поиск и генерация от
# этого не зависят, теряется только переиндексация без повторной загрузки и
# подсветка фрагмента в Source Viewer на этапе 3). Timeweb: Хранилище S3 →
# Создать бакет; endpoint обычно https://s3.twcstorage.ru.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1

# Параллелизм OCR сканов (rag/processor.py). Подберите под число vCPU тарифа
# Timeweb — больше значение ускоряет распознавание, но повышает пиковую память
# при одновременном рендере нескольких страниц.
OCR_WORKERS=4

# Telegram ID администраторов через запятую
ADMIN_IDS_RAW=123456789

# --- Доступ к сервису (ТЗ §28, §33) ------------------------------------------
# Service-to-service токен для /v1: им подтверждает себя образовательный сайт
# MedAP. Пусто = /v1 отключён (503). Сгенерировать: openssl rand -hex 32
SERVICE_TOKEN=

# Закрытая админка: пароль входа и секрет подписи сессионной куки.
# Секрет тоже случайная строка (openssl rand -hex 32).
ADMIN_WEB_PASSWORD=
ADMIN_SESSION_SECRET=

# Лимит запросов к /v1 на пользователя в минуту и максимальный размер
# загружаемого через админку файла источника (МБ).
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=300

# Личный документ студента (§18): лимит размера файла (МБ) и отдельный лимит
# запросов в минуту именно на загрузку — не делит квоту с обычными вопросами.
USER_DOCUMENT_MAX_MB=20
USER_DOCUMENT_UPLOAD_PER_MINUTE=3

# Web Research (§19, §34): фетч одной страницы по URL — таймаут, лимит размера
# страницы (КБ) и сколько текста реально уходит в промпт (символы).
WEB_RESEARCH_TIMEOUT_SECONDS=10
WEB_RESEARCH_MAX_KB=2048
WEB_RESEARCH_MAX_CHARS=12000

# Ключ для старого HTTP /search (api/main.py) — сервис-сервис вызов из другого
# репозитория (medap, сценарист рилсов), не для людей. Пусто = /search отключён (503).
RAG_API_KEY=

# Версии для воспроизводимости ответа (ТЗ §35): попадают в метаданные ответа
# и в каждую запись о расходе.
PROMPT_VERSION=v1
RETRIEVAL_VERSION=v2-hybrid-bm25-rrf

# Бюджеты вывода (ТЗ §57). У режима «на паре» ответ намеренно короткий.
MAX_OUTPUT_TOKENS=1500
CLASS_QUICK_MAX_OUTPUT_TOKENS=350

# Эмбеддинги
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# Реранкер (cross-encoder). Топовый по качеству, нужно ≥16 ГБ RAM рядом с e5-large.
# При нехватке RAM: RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_BATCH_SIZE=16

# Лимиты
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=50

# Чанкинг и поиск
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
# Кандидатов достаём вектором, затем реранкер оставляет RERANK_TOP_K
# Больше RERANK_TOP_K → больше материала в контексте → подробнее ответ
# (лишнее отсекается порогом RERANK_SCORE_THRESHOLD)
RETRIEVAL_CANDIDATES=60
RERANK_TOP_K=12
# Порог релевантности реранкера 0..1 (откалибровать через scripts/eval_rag.py)
RERANK_SCORE_THRESHOLD=0.3
MAX_DISTANCE_THRESHOLD=0.5
